# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# ── AWS Cognito (OpenID Connect) — client-side (navegador) ────────────────────
# O fluxo OIDC roda no navegador (Authorization Code + PKCE), sem backend e sem
# client secret. Use um app client PÚBLICO (criado SEM "Generate client secret").
# Estas duas variáveis (prefixo VITE_) são lidas pelo front-end.

# Domínio da hosted UI (App integration → Domain). Sem "https://".
VITE_COGNITO_DOMAIN="us-east-12pllvjx5q.auth.us-east-1.amazoncognito.com"

# ID do app client PÚBLICO (sem segredo) criado no User Pool.
VITE_COGNITO_CLIENT_ID="cole-aqui-o-id-do-app-client-publico"

# Observação: o login do Google é acionado via identity_provider=Google
# (Google configurado como identity provider no User Pool). O segredo do Google
# fica guardado no Cognito, não no app. Não há variáveis de servidor aqui — o
# fluxo é 100% no navegador (PKCE), por isso funciona no Amplify (hosting estático).
