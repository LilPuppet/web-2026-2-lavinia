# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# ── AWS Cognito (OpenID Connect) ──────────────────────────────────────────────
# Backend de autenticação (server.ts) lê estas variáveis via dotenv.
# O front-end lê apenas as que começam com VITE_ (vindas do Vite).

# Issuer (User Pool) — URL do .well-known/openid-configuration do Cognito
COGNITO_ISSUER="https://cognito-idp.us-east-1.amazonaws.com/us-east-1_2plLvJx5Q"

# Client ID do app client criado no Cognito
COGNITO_CLIENT_ID="6hkbh9iqrcg1ij7984vqgq1ofp"

# SEGREDO do app client — NUNCA commitar o valor real. Preencha no seu .env local.
COGNITO_CLIENT_SECRET=""

# URI de callback cadastrada no Cognito (deve bater exatamente com a registrada)
#   dev  → http://localhost:3000/auth/callback
#   prod → https://d84l1y8p4kdic.cloudfront.net/auth/callback
COGNITO_REDIRECT_URI="http://localhost:3000/auth/callback"

# Para onde voltar após o logout no Cognito
COGNITO_LOGOUT_URI="http://localhost:3000"

# Scopes solicitados ao Cognito
COGNITO_SCOPE="openid email profile phone"

# Nome do identity provider do Google no User Pool (default "Google").
# Usado para o deep-link /auth/google (identity_provider=...). O segredo do
# Google fica guardado no Cognito (Google identity provider), não no app.
COGNITO_GOOGLE_IDP_NAME="Google"

# Segredo do cookie de sessão (express-session) — use um valor aleatório longo em prod
SESSION_SECRET="cliniflow-dev-secret-change-me"

# Porta do backend de auth (o Vite dev faz proxy de /auth para esta porta)
AUTH_PORT=3001

# Origem do backend de auth vista pelo front-end.
#   Em dev: vazio (mesma origem via proxy do Vite) → ""
#   Em prod: a origem que serve o server.ts (ex.: a mesma do CloudFront) → ""
VITE_AUTH_BASE=""
